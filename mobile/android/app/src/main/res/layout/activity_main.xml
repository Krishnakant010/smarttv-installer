<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_dark_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_dark_background"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_wifi_tv"
            app:navigationIconTint="@color/md_theme_dark_primary"
            app:title="SmartTV Sideload"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
            app:titleTextColor="@color/md_theme_dark_onSurface"
            app:subtitle="Direct Network Installer"
            app:subtitleTextAppearance="@style/TextAppearance.Material3.BodySmall"
            app:subtitleTextColor="@color/md_theme_dark_onSurfaceVariant"
            app:menu="@null">

            <ImageView
                android:id="@+id/btnHelpGuide"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Connection Guide"
                android:padding="8dp"
                android:src="@drawable/ic_info"
                app:tint="@color/md_theme_dark_onSurfaceVariant" />
        </com.google.android.material.appbar.MaterialToolbar>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_theme_dark_outlineVariant" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.06"
                android:text="TARGET PLATFORM"
                android:textColor="@color/md_theme_dark_onSurfaceVariant"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/togglePlatform"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:checkedButton="@id/btnWebOs"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWebOs"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:letterSpacing="0.02"
                    android:text="LG webOS"
                    android:textAllCaps="false"
                    android:textColor="@color/md_theme_dark_onSurface"
                    android:textSize="13sp"
                    app:strokeColor="@color/md_theme_dark_outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTizen"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:letterSpacing="0.02"
                    android:text="Samsung Tizen"
                    android:textAllCaps="false"
                    android:textColor="@color/md_theme_dark_onSurface"
                    android:textSize="13sp"
                    app:strokeColor="@color/md_theme_dark_outline" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.06"
                android:text="NETWORK CONNECTION"
                android:textColor="@color/md_theme_dark_onSurfaceVariant"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.SurfaceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.App.OutlinedTextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="TV IP Address"
                        app:helperText="Local Wi-Fi IP (e.g. 192.168.1.100)"
                        app:startIconDrawable="@drawable/ic_wifi_tv"
                        app:startIconTint="@color/md_theme_dark_primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etIpAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.App.OutlinedTextField"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Port">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:text="9922"
                                android:textColor="@color/md_theme_dark_onSurface"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <View
                            android:id="@+id/viewPassphraseSpacer"
                            android:layout_width="12dp"
                            android:layout_height="0dp" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutPassphrase"
                            style="@style/Widget.App.OutlinedTextField"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.6"
                            android:hint="LG Passphrase"
                            app:endIconMode="password_toggle"
                            app:endIconTint="@color/md_theme_dark_onSurfaceVariant">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etPassphrase"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:textColor="@color/md_theme_dark_onSurface"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.06"
                android:text="APPLICATION PACKAGE"
                android:textColor="@color/md_theme_dark_onSurfaceVariant"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.SurfaceCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.App.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Choose App Preset"
                        app:startIconDrawable="@drawable/ic_package"
                        app:startIconTint="@color/md_theme_dark_primary">

                        <AutoCompleteTextView
                            android:id="@+id/actvPresets"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="14sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/layoutAppSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/badge_bg"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvAppDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/md_theme_dark_onSurface"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvAppIdBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="monospace"
                            android:textColor="@color/md_theme_dark_primary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutCustomFields"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.App.OutlinedTextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="GitHub Repo (e.g. owner/repo)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCustomRepo"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textUri"
                                android:textColor="@color/md_theme_dark_onSurface"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.App.OutlinedTextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="Package / App ID Override">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAppId"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:textColor="@color/md_theme_dark_onSurface"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInstall"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:letterSpacing="0.04"
                android:text="Install to TV"
                android:textColor="@color/md_theme_dark_onPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/md_theme_dark_primary"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_install"
                app:iconGravity="textStart"
                app:iconTint="@color/md_theme_dark_onPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLaunch"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Launch"
                    android:textColor="@color/md_theme_dark_onSurface"
                    android:textSize="13sp"
                    app:backgroundTint="@color/md_theme_dark_surfaceContainerHigh"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_launch"
                    app:iconGravity="textStart"
                    app:iconTint="@color/md_theme_dark_onSurface" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="0dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUninstall"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Uninstall"
                    android:textColor="@color/md_theme_dark_error"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconTint="@color/md_theme_dark_error"
                    app:strokeColor="@color/md_theme_dark_outline" />
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/md_theme_dark_primary"
                app:trackColor="@color/md_theme_dark_surfaceContainerHighest"
                app:trackCornerRadius="4dp"
                app:trackThickness="4dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.SurfaceCard"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                app:cardBackgroundColor="@color/terminal_bg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@color/md_theme_dark_surface"
                        android:paddingHorizontal="14dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_terminal"
                                app:tint="@color/md_theme_dark_onSurfaceVariant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:letterSpacing="0.04"
                                android:text="ACTIVITY LOG"
                                android:textColor="@color/md_theme_dark_onSurfaceVariant"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/btnCopyLogs"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Copy Log"
                                android:padding="7dp"
                                android:src="@drawable/ic_copy"
                                app:tint="@color/md_theme_dark_onSurfaceVariant" />

                            <ImageView
                                android:id="@+id/btnClearLogs"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginStart="4dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Clear Log"
                                android:padding="7dp"
                                android:src="@drawable/ic_clear"
                                app:tint="@color/md_theme_dark_onSurfaceVariant" />
                        </LinearLayout>
                    </RelativeLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/md_theme_dark_outline" />

                    <ScrollView
                        android:id="@+id/scrollLogs"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true"
                        android:overScrollMode="never">

                        <TextView
                            android:id="@+id/tvLogs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:lineSpacingExtra="3dp"
                            android:padding="12dp"
                            android:text="System ready. Select target television and app package to proceed.\n"
                            android:textColor="@color/terminal_text"
                            android:textSize="12sp" />
                    </ScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
